{
   "action": {
      "default_icon": {
         "128": "mht-icon.png"
      }
   },
   "background": {
      "service_worker": "dist/worker.js",
      "type": "module"
   },
   "commands": {
      "_execute_action": {
         "suggested_key": {
            "default": "Alt+Shift+S"
         }
      }
   },
   "description": "Save page as `.mht` files.",
   "homepage_url": "https://github.com/vsDizzy/SaveAsMHT",
   "host_permissions": [ "file:///*", "http://*/*", "https://*/*" ],
   "icons": {
      "128": "mht-icon.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Save As MHT",
   "permissions": [ "tabs", "pageCapture", "downloads", "contextMenus", "scripting", "activeTab", "cookies", "storage" ],
   "short_name": "SaveAsMHT",
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "0.2.0"
}
